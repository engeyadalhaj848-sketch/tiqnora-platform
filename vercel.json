{
  "crons": [
    {
      "path": "/api/reports/telegram",
      "schedule": "0 18 * * *"
    }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog-post.html?slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/compare",
      "destination": "/compare.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/services/:slug.html"
    }
  ],
  "routes": [
    {
      "src": "/blog/([^/]+)",
      "dest": "/blog-post.html?slug=$1"
    },
    {
      "src": "/blog",
      "dest": "/blog.html"
    },
    {
      "src": "/compare",
      "dest": "/compare.html"
    },
    {
      "src": "/services/([^/]+)",
      "dest": "/services/$1.html"
    }
  ]
}
