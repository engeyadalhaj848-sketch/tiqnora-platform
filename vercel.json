{
  "crons": [
    {
      "path": "/api/reports/telegram",
      "schedule": "0 18 * * *"
    }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/blog/:slug/",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/compare",
      "destination": "/compare.html"
    },
    {
      "source": "/services/:slug",
      "destination": "/services/:slug.html"
    },
    {
      "source": "/sales",
      "destination": "/sales.html"
    },
    {
      "source": "/national-day",
      "destination": "/national-day.html"
    },
    {
      "source": "/national-day/",
      "destination": "/national-day.html"
    },
    {
      "source": "/shipping-policy",
      "destination": "/shipping-policy.html"
    },
    {
      "source": "/shipping-policy/",
      "destination": "/shipping-policy.html"
    },
    {
      "source": "/return-policy",
      "destination": "/return-policy.html"
    },
    {
      "source": "/return-policy/",
      "destination": "/return-policy.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/faq/",
      "destination": "/faq.html"
    }
  ]
}
