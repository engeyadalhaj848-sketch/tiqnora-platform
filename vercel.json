      "destination": "/api/billing/providers?route=aliexpress_status"
    },
    {
      "source": "/api/suppliers/fulfillment-submit",
      "destination": "/api/billing/providers?route=supplier_fulfillment_submit"
    },
    {
      "source": "/api/suppliers/fulfillment-submit/",
      "destination": "/api/billing/providers?route=supplier_fulfillment_submit"
    },
    {
      "source": "/api/payments/create-checkout",
      "destination": "/api/billing/providers?route=whop_create_checkout"
    },
    {
      "source": "/api/orders/create",
      "destination": "/api/billing/providers?route=order_create"
    },
    {
      "source": "/api/orders/create/",
      "destination": "/api/billing/providers?route=order_create"
    },
    {
      "source": "/api/payments/order-status",
      "destination": "/api/billing/providers?route=whop_order_status"
    },
    {
      "source": "/api/payments/whop/webhook",
      "destination": "/api/billing/providers?route=whop_webhook"
    },
    {
      "source": "/order-complete",
      "destination": "/order-complete.html"
    },
    {
      "source": "/order-complete/",
      "destination": "/order-complete.html"
    },
    {
      "source": "/api/webhooks/meta",
      "destination": "/api/social/webhook?platform=meta"
    },
    {
