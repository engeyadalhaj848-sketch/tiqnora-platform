{
  "crons": [
    {
      "path": "/api/reports/telegram",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/reports/telegram",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/social/publish-worker",
      "schedule": "*/15 * * * *"
    }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/customer",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/customer.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/checkout",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/checkout.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/track",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/track.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/proposal/:token/",
      "destination": "/proposal.html"
    },
    {
      "source": "/proposal/:token",
      "destination": "/proposal.html"
    },
    {
      "source": "/api/ai-sales/draft-reply",
      "destination": "/api/v6?route=draft_reply"
    },
    {
      "source": "/api/actions",
      "destination": "/api/v6?route=actions"
    },
    {
      "source": "/api/actions/:id",
      "destination": "/api/v6?route=action&id=:id"
    },
    {
      "source": "/api/sales/chat",
      "destination": "/api/v6?route=sales_chat"
    },
    {
      "source": "/api/ai-workforce/providers",
      "destination": "/api/ai-workforce/chat?route=providers"
    },
    {
      "source": "/api/telegram/webhook",
      "destination": "/api/reports/telegram?route=telegram_webhook"
    },
    {
      "source": "/api/telegram/health",
      "destination": "/api/reports/telegram?route=telegram_health"
    },
    {
      "source": "/api/aliexpress/connect",
      "destination": "/api/billing/providers?route=aliexpress_connect"
    },
    {
      "source": "/api/aliexpress/connect/",
      "destination": "/api/billing/providers?route=aliexpress_connect"
    },
    {
      "source": "/api/aliexpress/callback",
