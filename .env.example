# Telegram Command Center
# Add TELEGRAM_BOT_TOKEN in Vercel, redeploy Production, then pair the owner chat once.
# TELEGRAM_CHAT_ID / TELEGRAM_ALLOWED_CHAT_IDS are optional fallbacks; secure pairing can store the owner chat in Supabase.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

CRON_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=

# ── Supplier connectors (Vercel Environment Variables only) ──
