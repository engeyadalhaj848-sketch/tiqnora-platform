# Whop Payments — SERVER SIDE ONLY (never NEXT_PUBLIC_*)
# Sandbox: https://sandbox.whop.com — API https://sandbox-api.whop.com/api/v1
WHOP_ENVIRONMENT=sandbox
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_WEBHOOK_SECRET=
# Charge currency on Whop (usd recommended for sandbox tests; sar if account supports it)
WHOP_CURRENCY=usd
# Optional
WHOP_API_VERSION_DATE=2026-07-01
SAR_TO_USD_RATE=0.2667
